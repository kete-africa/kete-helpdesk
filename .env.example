# The app's Postgres (Neon), through its application role (no BYPASSRLS).
DATABASE_URL=""
# The owner role: migrations at start-up, and the jobs' schema (kete_jobs).
OWNER_DATABASE_URL=""
# Where this app is served, e.g. https://template.kete.africa
PUBLIC_URL="http://localhost:3400"
# The Compte Kete, and this app's registration there (an operator registers it).
KETE_ACCOUNT_URL="https://compte.kete.africa"
KETE_CLIENT_ID=""
KETE_CLIENT_SECRET=""
# Signs this app's own session cookie: 32 characters at least, this app only.
SESSION_SECRET=""
# Kete's own organization: its owners and admins are Kete operators.
KETE_OPERATORS_ORGANIZATION_ID=""
# E-mails (@kete/notify): a MailKite key restricted to the sending domain; without it, nothing leaves.
MAILKITE_API_KEY=""
MAIL_FROM="Kete <bonjour@kete.africa>"
# Events to Kete Cockpit (@kete/sdk): the key the Cockpit hands out.
KETE_EVENTS_URL=""
KETE_EVENTS_KID=""
KETE_EVENTS_SECRET=""
KETE_ENVIRONMENT="development"
# Tests: a Neon "test" branch (owner and application roles), or KETE_TEST_POSTGRES=container.
KETE_TEST_OWNER_URL=""
KETE_TEST_APP_URL=""

# Kete Enterprise's API: the queues' indicators are sent there as readings (optional).
ENTERPRISE_API_URL=
# Kete Finance's address: a billable ticket's invoice is prepared there. Empty: not connected.
FINANCE_URL=""
